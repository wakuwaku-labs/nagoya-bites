{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/session_briefing.js\"",
            "timeout": 40
          }
        ]
      },
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/linear/briefing.js\"; [ -f \"$f\" ] && node \"$f\" || true",
            "timeout": 40
          }
        ]
      }
    ]
  }
}
